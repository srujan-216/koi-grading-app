# Copy to .env for local Postgres testing (don't commit the real file).

# -------- Database --------
# If unset, the app uses local SQLite (KOA_DB, default koa_grading.db).
# For deployment, point this at your Supabase POOLED Postgres URL (port 6543)
# — Supabase project settings -> Database -> Connection string -> "Transaction".
# Must include ?sslmode=require.
KOA_PG_URL=postgresql://postgres.<proj>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# -------- Images --------
# Local dev: filesystem folder with images/ and patient_montages/
KOA_IMAGES=D:\downloads\grading_app\COHORT_VIS

# Legacy — PUBLIC bucket base URL. Leave blank unless you host images
# in a public-read bucket. The signed-URL path (below) is preferred for
# confidential cohorts.
KOA_IMAGE_BASE_URL=

# -------- Deployment image serving (preferred: PRIVATE bucket) --------
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY + SUPABASE_BUCKET are all set,
# the app generates 1-hour signed URLs from a PRIVATE Supabase Storage bucket.
# This is the config used by the deployed app.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key_from_supabase_settings>
SUPABASE_BUCKET=koa-cohort

# -------- Admin --------
# Long random string. Required for /Admin to show anything.
ADMIN_TOKEN=change-me-to-a-long-random-string

# -------- App login (deployment) --------
# One username:password[:role] per line. Role defaults to "Radiologist".
USERS=
# j1:jade-cobalt-71:PG / Resident
# s1:cedar-plum-83:Consultant/Senior Radiologist
# s2:rapid-noble-29:Consultant/Senior Radiologist
